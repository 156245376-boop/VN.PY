# 凭证模板(R22.3/R22.5)。
#
# 用法:复制为 conf/local.toml 后填入真实值。**conf/local.toml 已列入 .gitignore,
# 永不进版本库**;本模板只保留字段名与占位值。
#
# 环境变量优先于本文件(R22.6)。注意 R22.11 的往返属性只对文件层配置成立 ——
# 有效值来自环境变量时,序列化再解析无法还原(D6),故配置对象须记住取值来源。

[ctp]
# environment 取值为 "simnow" 或 "real"(R1.9)。
# Phase 6 用 SimNow 验证的是**管路**(登录、流控、委托生命周期、平今标志、重连、
# 状态恢复),不是盈亏 —— SimNow 的撮合不真实。
environment = "simnow"

userid = "<资金账号>"
password = "<密码>"
brokerid = "<经纪商代码,例如 9999>"

# 行情与交易前置地址。SimNow 与实盘不同,由期货公司提供。
md_address = "tcp://<行情前置>:<端口>"
td_address = "tcp://<交易前置>:<端口>"

# 穿透式监管(C3)。**没有这两项会登录失败,且 CTP 错误码不直观 ——
# 典型情形是 20:59 才发现。** 故 R1.1 要求做成启动前置检查,在开盘前大声失败。
# 二者由期货公司申请后发放。
appid = "<AppID>"
authcode = "<AuthCode>"

# 产品信息,部分期货公司要求填写。
product_info = ""

[subscribe]
# 订阅清单。条目支持具体合约代码与品种代码两种形式(R2.1),
# 品种代码会在 CTP 合约查询完成后展开为该品种当前全部挂牌合约(R2.2)。
symbols = ["rb", "MA"]

# tick 落库白名单(R4.1)。**只有此清单内的合约会落 tick。**
# 容量估算:20 个合约 × 约 4.1 万 tick/日 × 250 日 ≈ 每年 2 亿条。
# 走 Parquet 按交易日分区(R25.4),列式压缩后约 10–15 字节/行。
tick_whitelist = ["rb2510.SHFE"]

# 1 分钟 K 线落库范围(R5.1)。留空表示已订阅的全部合约。
recording_whitelist = []

[alert]
# 告警推送地址(R21.4)。留空则只记日志不推送。
# 处置类别为「需人工放行」的告警不受去重窗口限制(R21.5)——
# 对账不符、穿透式监管失败这类必须每次都推。
push_url = ""
