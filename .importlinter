; 分层契约 —— R24.2/R24.5/R24.10 的机械强制手段。
;
; 这不是装饰:没有它,「一次只改一个文件夹」会在两个月内失效。
; 同一行内以 ":" 分隔的模块为独立同级,互相不得导入。
;
; 层级编号见 CLAUDE.md。修改本文件等同于修改架构约束,须同时更新 CLAUDE.md 并追加 ADR。

[importlinter]
root_packages =
    core
    config
    obs
    meta
    data
    indicators
    strategy
    costs
    execution
    risk
    engines
    gateway
    runtime
    apps
include_external_packages = True

[importlinter:contract:layers]
name = 模块层级(导入只能向下)
type = layers
layers =
    apps
    runtime
    engines : gateway
    execution : risk
    costs
    strategy
    indicators
    data
    meta
    config : obs
    core

; ---------------------------------------------------------------------------
; R11.2 / R24.13:策略层不得出现任何交易框架的导入语句。
; 违反后果:策略被永久锁死在 vnpy,更换回测引擎需重写每个策略文件(ADR-0004)。
; ---------------------------------------------------------------------------
[importlinter:contract:strategy-no-framework]
name = strategy 不得导入交易框架
type = forbidden
source_modules =
    strategy
forbidden_modules =
    vnpy
    vnpy_ctp
    vnpy_ctastrategy
    vnpy_ctabacktester
    pandas
    polars
    duckdb
    pyarrow

; ---------------------------------------------------------------------------
; data 模块不得导入 vnpy。
;
; Phase 3 会加入唯一例外:`data/vnpy_db.py` 是供 vnpy 回测引擎读 Bar 的垫片(A5),
; 隔离在单个叶子文件内使存储层仍可被自研引擎复用。届时须在此追加:
;
;     ignore_imports =
;         data.vnpy_db -> vnpy
;         data.vnpy_db -> vnpy.**
;
; 现在不预先写入 —— import-linter 会因该例外无匹配而报错。而不写反倒更可靠:
; Phase 3 给 vnpy_db.py 添上 import 的那一刻本契约立即破裂,强制补上例外并
; 重新确认"只有这一个文件"仍然成立。永久告警只会训练人忽略输出。
; ---------------------------------------------------------------------------
[importlinter:contract:data-vnpy-only-in-shim]
name = data 不得导入 vnpy(Phase 3 起 vnpy_db 例外)
type = forbidden
source_modules =
    data
forbidden_modules =
    vnpy
    vnpy_ctp
    vnpy_ctastrategy

; ---------------------------------------------------------------------------
; 交易框架只允许出现在 engines(适配器)、gateway(CTP 连接)、apps(装配)。
; core/meta/costs/execution/risk 必须对框架无感知,否则费用与开平逻辑无法被
; 自研引擎复用(ADR-0003/ADR-0005)。
; ---------------------------------------------------------------------------
[importlinter:contract:domain-no-framework]
name = 领域层不得导入交易框架
type = forbidden
source_modules =
    core
    config
    obs
    meta
    indicators
    costs
    execution
    risk
forbidden_modules =
    vnpy
    vnpy_ctp
    vnpy_ctastrategy
    vnpy_ctabacktester

; ---------------------------------------------------------------------------
; R24.14:监控外壳只读状态快照。这条可机械检查,它保证监控面板不可能意外
; 拿锁、开 CTP 会话或碰交易库 —— 双进程方案(ADR-0008)的技术兑现。
; ---------------------------------------------------------------------------
[importlinter:contract:monitor-readonly]
name = apps.monitor 仅依赖 obs 与 core
type = forbidden
source_modules =
    apps.monitor
forbidden_modules =
    meta
    data
    indicators
    strategy
    costs
    execution
    risk
    engines
    gateway
    runtime
    vnpy
    vnpy_ctp
    duckdb

; ---------------------------------------------------------------------------
; R19:风控为纯否决函数,不得依赖执行细节。
; ---------------------------------------------------------------------------
[importlinter:contract:risk-pure]
name = risk 不得导入 execution
type = forbidden
source_modules =
    risk
forbidden_modules =
    execution
